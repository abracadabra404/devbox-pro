{
  "name": "devbox-pro",
  "version": "0.1.0",
  "description": "All-in-one cross-platform developer desktop tool.",
  "main": "./out/main/index.js",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
